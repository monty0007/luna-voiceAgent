# ============================================================================
# Mode
# ============================================================================
# realtime (default): direct gpt-realtime speech-to-speech, API-key auth, fastest.
# agent: Voice Live in front of a Foundry prompt agent (tools: Work IQ / MCP),
#        Entra ID auth (`az login`), slower.
VOICE_MODE=realtime

# --- Realtime mode
VOICELIVE_API_KEY=
VOICELIVE_MODEL=gpt-realtime-2.1
# OpenAI voice names in realtime mode: alloy, ash, ballad, coral, echo, sage,
# shimmer, verse, marin, cedar. (Agent mode uses an Azure neural voice, below.)
# REALTIME_INSTRUCTIONS=
# REALTIME_TRANSCRIPTION_MODEL=azure-speech
# --- AI gateway (LiteLLM). If BOTH are set, realtime mode connects through the
# gateway (wss://<gateway>/v1/realtime) with a Bearer key, and VOICELIVE_ENDPOINT /
# VOICELIVE_API_KEY are not used. Models: gpt-realtime-2.1, gpt-5.6-terra, gpt-5.4-mini.
# AI_GATEWAY_BASE_URL=https://<gateway>      (with or without /v1)
# AI_GATEWAY_KEY=
# AI_GATEWAY_REALTIME_MODEL=gpt-realtime-2.1
# AI_GATEWAY_CHAT_MODEL=gpt-5.6-terra        (used by scripts/check_gateway.py)
# GATEWAY_TRANSCRIPTION_MODEL=whisper-1      (the gateway has no azure-speech)
# GATEWAY_TRANSCRIPTION_LANGUAGE=en          (stops whisper mis-detecting other languages)
# GATEWAY_HALF_DUPLEX=1                      (mic muted while the agent speaks: stops speaker echo
#                                             self-interrupting; set 0 with headphones to allow barge-in)
# GATEWAY_ECHO_TAIL_MS=500                   (extra mute after playback ends)
# GATEWAY_VAD_THRESHOLD=0.6   GATEWAY_NOISE_REDUCTION=far_field   (near_field for a headset)
# --- Microsoft Graph calendar tool (needs REALTIME_TOOLS=1). One-time: python scripts/graph_login.py
# GRAPH_CLIENT_ID=            (Entra app, delegated Calendars.Read, public client flows on)
# GRAPH_TENANT_ID=
# Opt in to local function tools (src/local_tools.py) in realtime mode:
# REALTIME_TOOLS=1

# ============================================================================
# Runtime tuning (all optional)
# ============================================================================
# AUDIO_PREBUFFER_MS=100     # playback jitter buffer; raise (150-250) if audio is choppy
# AUDIO_CHUNK_MS=20          # mic/speaker block size; raise (40-50) if audio crackles
# VAD_SILENCE_MS=400         # silence before your turn ends; lower = snappier, may cut you off
#                            # (agent mode: re-run create_agent.py after changing)
# RESPONSE_TIMEOUT_S=20      # warn if no reply audio arrives this long after you stop
# MAX_RECONNECTS=5           # auto-reconnect attempts if the connection drops
# LOG_LEVEL=INFO
# CONVERSATION_LOG=1         # 0 = don't write transcripts to src/logs/

# ============================================================================
# Foundry project (the "brain" of the voice agent)
# ============================================================================
# Full project endpoint, format:
#   https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
PROJECT_ENDPOINT=

# Just the project name (last path segment of PROJECT_ENDPOINT)
PROJECT_NAME=

# Model deployment name in the Foundry project. This is the agent's REASONING
# model (text) — it understands the request, calls Work IQ/MCP tools, and
# composes the answer. Pick a tool-capable model (gpt-5, gpt-5-mini, gpt-4.1).
# NOTE: this is separate from the Voice Live SPEECH model (e.g. gpt-realtime-2.1),
# which handles the realtime speech-to-text + text-to-speech and is configured
# on the Voice Live session/resource, not here.
MODEL_DEPLOYMENT_NAME=gpt-5-mini  # use the agent-model deployment from your Foundry project

# Name for the prompt agent we create
AGENT_NAME=voice-agent

# ============================================================================
# Voice Live (the realtime speech-to-speech front-end)
# ============================================================================
# Voice Live endpoint from the Azure portal (Keys and Endpoint), format:
#   https://<resource-name>.services.ai.azure.com/
VOICELIVE_ENDPOINT=

VOICELIVE_API_VERSION=2026-04-10

# Voice used for spoken replies (Azure standard / HD neural voice)
VOICE_NAME=en-US-Ava:DragonHDLatestNeural

# Optional: agent system prompt (re-run create_agent.py after changing) and
# how many agent versions to keep (older ones are pruned; 0 = never prune)
# AGENT_INSTRUCTIONS=
# AGENT_VERSIONS_KEEP=5
# TRANSCRIPTION_MODEL=mai-transcribe-2

# Optional: pin a specific agent version / resume a conversation
# AGENT_VERSION=
# CONVERSATION_ID=

# ============================================================================
# Tools (Work IQ + MCP) — optional. Leave blank to create a plain agent first.
# ============================================================================
# --- Phase 2 inputs (Work IQ connection + toolbox), used by scripts/workiq_toolbox.py
# From your Entra app registration (after the one-time admin setup):
# WORKIQ_TENANT_ID=
# WORKIQ_CLIENT_ID=
# WORKIQ_CLIENT_SECRET=
# Optional names (defaults shown):
# WORKIQ_CONNECTION_NAME=workiq-conn
# TOOLBOX_NAME=work-iq-toolbox

# --- Phase 2 outputs (fill after running scripts/workiq_toolbox.py), used by create_agent.py
# Foundry connection name/ID for the toolbox MCP endpoint
# TOOLBOX_PROJECT_CONNECTION_ID=
# Full MCP URL of the toolbox, format:
#   https://<resource>.services.ai.azure.com/api/projects/<project>/toolboxes/<toolbox-name>/mcp?api-version=v1
# TOOLBOX_SERVER_URL=

# --- Alternative: attach Work IQ directly to the agent (skip the toolbox)
# WORK_IQ_PROJECT_CONNECTION_ID=

